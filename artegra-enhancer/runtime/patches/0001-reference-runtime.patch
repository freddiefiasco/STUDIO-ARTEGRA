+def _sage3_preflight_reason(q, k, v, heads, mask, attn_precision, skip_reshape, kwargs):
+    if mask is not None:
+        return "mask"
+    if kwargs.get("scale", None) is not None:
+        return "custom_scale"
+    if attn_precision == torch.float32:
+        return "fp32_attention_precision"
+    if kwargs.get("low_precision_attention", True) is False:
+        return "low_precision_opt_out"
+
+    tensors = (q, k, v)
+    if any(tensor.device.type != "cuda" for tensor in tensors):
+        return "not_cuda"
+    if any(tensor.device != q.device for tensor in tensors[1:]):
+        return "device_mismatch"
+    if q.dtype not in (torch.float16, torch.bfloat16):
+        return "unsupported_dtype"
+    if any(tensor.dtype != q.dtype for tensor in tensors[1:]):
+        return "dtype_mismatch"
+
+    try:
+        capability = torch.cuda.get_device_capability(q.device)
+    except (AssertionError, RuntimeError):
+        return "capability_unavailable"
+    if capability not in ((12, 0), (12, 1)):
+        return "unsupported_compute_capability"
+
+    if skip_reshape:
+        if len(q.shape) != 4 or q.shape[1] != heads:
+            return "invalid_head_shape"
+        sequence = q.shape[-2]
+        dim_head = q.shape[-1]
+    else:
+        if len(q.shape) != 3 or q.shape[-1] % heads != 0:
+            return "invalid_head_shape"
+        sequence = q.shape[1]
+        dim_head = q.shape[-1] // heads
+
+    if dim_head not in (64, 128):
+        return "unsupported_head_dim"
+    if sequence <= 1024:
+        return "sequence_too_short"
+    return None
+
