diff --git a/tests-unit/comfy_extras_test/test_nodes_multigpu.py b/tests-unit/comfy_extras_test/test_nodes_multigpu.py
new file mode 100644
index 0000000000000000000000000000000000000000..18821a7c430e7669ba0efe8be7c69de226802a14
--- /dev/null
+++ b/tests-unit/comfy_extras_test/test_nodes_multigpu.py
@@ -0,0 +1,35 @@
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from comfy_extras import nodes_multigpu
+
+
+class FakeCLIP:
+    def __init__(self, patcher, cond_stage_model):
+        self.patcher = patcher
+        self.cond_stage_model = cond_stage_model
+
+    def clone(self):
+        return FakeCLIP(self.patcher, self.cond_stage_model)
+
+
+class SelectCLIPDeviceNodeTests(unittest.TestCase):
+    def test_retargeted_execution_model_matches_patcher_for_gpu_and_default(self):
+        for device, resolved in (("gpu:1", SimpleNamespace(type="cuda")), ("default", None)):
+            with self.subTest(device=device):
+                original_model = object()
+                retargeted_model = object()
+                clip = FakeCLIP(SimpleNamespace(model=original_model), original_model)
+                with (
+                    patch.object(nodes_multigpu.comfy.model_management, "resolve_gpu_device_option", return_value=resolved),
+                    patch.object(nodes_multigpu, "_apply_patcher_device", return_value=SimpleNamespace(model=retargeted_model)),
+                ):
+                    selected = nodes_multigpu.SelectCLIPDeviceNode.execute(clip, device)[0]
+
+                self.assertIs(selected.patcher.model, retargeted_model)
+                self.assertIs(selected.cond_stage_model, selected.patcher.model)
+
+
+if __name__ == "__main__":
+    unittest.main()
